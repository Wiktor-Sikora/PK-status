---
import "../styles/global.css";
import Dashboard from "../components/Dashboard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PK Status</title>
    <meta
      name="description"
      content="Live status of Politechnika Krakowska services"
    />
  </head>
  <body class="min-h-screen bg-slate-900 text-slate-100 antialiased">
    <main class="mx-auto max-w-3xl px-4 py-12">
      <header class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight">PK Status</h1>
        <p class="mt-1 text-slate-400">
          Live status of Politechnika Krakowska services.
        </p>
      </header>
      <Dashboard client:load />
    </main>
  </body>
</html>
